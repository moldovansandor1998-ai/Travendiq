    "maplibre-gl": "4.7.1",
    "next": "16.3.3",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "4.0.1",
    "stripe": "17.5.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.13",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "autoprefixer": "10.4.20",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.3",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.17",
