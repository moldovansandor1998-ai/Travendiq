# ===== Travendiq – környezeti változók =====
# Másold át .env.local néven. SOHA ne commitolj valódi értékeket.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # csak szerveroldalon!

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_DEFAULT_CURRENCY=EUR

# --- Stripe (test mód induláskor) ---
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Ha üres, a checkout DEV manuális jóváhagyást kínál (csak nem-production környezetben).

# --- Resend ---
RESEND_API_KEY=re_...
EMAIL_FROM="Travendiq <no-reply@travendiq.com>"
SUPPORT_EMAIL_FROM="Travendiq Support <support@travendiq.com>"

# --- Voucher / QR aláírás ---
VOUCHER_SIGNING_SECRET=generate-a-long-random-string

# --- Affiliate IP-hash (KÖTELEZŐ, külön erős titok; min. 16 karakter) ---
# Hiányában NEM tárolódik IP-hash az affiliate_clicks-ben (adatvédelem).
AFFILIATE_IP_SALT=generate-another-long-random-string

# --- Affiliate referral-cookie HMAC-aláírás (KÖTELEZŐ, külön erős titok; min. 16 karakter) ---
# Hiányában a /r/[code] NEM állít be referral-cookie-t, és minden feloldás null.
AFFILIATE_COOKIE_SECRET=generate-a-third-long-random-string

# --- Térkép tile provider (productionben kötelező beállítani!) ---
# Alapértelmezés az OSM demo tile szerver – éles forgalomra NEM használható.
# Pl. MapTiler: https://api.maptiler.com/maps/streets/{z}/{x}/{y}.png?key=...
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors

# --- Platform ---
PLATFORM_COMMISSION_DEFAULT=15        # százalék
SUPPORT_EMAIL=support@travendiq.com

# --- Védelem ---
RATE_LIMIT_BOOKING_PER_MINUTE=5

# --- Email outbox cron (Vercel Cron Authorization: Bearer <CRON_SECRET>) ---
CRON_SECRET=generate-a-long-random-string
# Admin-riasztások címe (pl. sikertelen transfer reversal, chargeback)
ADMIN_ALERT_EMAIL=admin@travendiq.com

# --- Integrációs tesztekhez (NEM kell az éles működéshez) ---
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY: integration tesztek célzott példánya
